# Commerce Data Agent local environment.
# Copy to .env.local and add one real model credential.

COMMERCE_DATABASE_URL="postgresql://commerce_app:commerce_local_password@127.0.0.1:35433/commerce_agent"
COMMERCE_ANALYTICS_DATABASE_URL="postgresql://commerce_app:commerce_local_password@127.0.0.1:35433/commerce_agent"
COMMERCE_ANALYTICS_MIGRATION_DATABASE_URL="postgresql://commerce_app:commerce_local_password@127.0.0.1:35433/commerce_agent"
COMMERCE_ANALYTICS_INGEST_DATABASE_URL="postgresql://commerce_app:commerce_local_password@127.0.0.1:35433/commerce_agent"
COMMERCE_PG_SSL=0
COMMERCE_PG_REJECT_UNAUTHORIZED=1
COMMERCE_PG_POOL_MAX=10

COMMERCE_DEV_AUTH_BYPASS=1
COMMERCE_DEV_TENANT_ID="tenant_local"
COMMERCE_DEV_USER_ID="operator_local"
COMMERCE_LLM_AGENT_ENABLED=1

# Choose one provider.
# DEEPSEEK_API_KEY=""
# MODELPORT_API_KEY=""
# COMMERCE_MODELPORT_URL="http://127.0.0.1:38082"
# COMMERCE_MODELPORT_ORGANIZATION_ID="org_commerce"
# COMMERCE_MODELPORT_PROJECT_ID="prj_commerce_agent"
# COMMERCE_MODELPORT_ENVIRONMENT_ID="env_development"

COMMERCE_AGENT_MAX_TURNS=8
COMMERCE_AGENT_MAX_TOOL_CALLS=12
COMMERCE_AGENT_TIMEOUT_MS=60000
COMMERCE_AGENT_GLOBAL_CONCURRENCY=8
COMMERCE_AGENT_TENANT_CONCURRENCY=4
COMMERCE_JOB_LEASE_MS=150000
COMMERCE_JOB_POLL_MS=1000
COMMERCE_JOB_MAX_ATTEMPTS=3
COMMERCE_MAX_QUEUED_JOBS_PER_USER=8
COMMERCE_WORKER_STALE_MS=30000
COMMERCE_MAX_DATA_AGE_HOURS=72
COMMERCE_RETENTION_DAYS=90

# Optional for local Prometheus scraping. Required in production.
COMMERCE_METRICS_TOKEN="local-metrics-token-material-0123456789"

# See specialized contracts:
# .env.commerce.example, .env.production.example, .env.commerce-jobs.example,
# and .env.release.example.
