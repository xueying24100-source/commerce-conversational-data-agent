# Commerce database jobs only. Never inject this file into the Web runtime.
NODE_ENV=production

COMMERCE_CONTROL_MIGRATION_DATABASE_URL="postgresql://commerce_migration_user:replace-me@postgres.example.com:5432/commerce_agent"
COMMERCE_ANALYTICS_MIGRATION_DATABASE_URL="postgresql://commerce_migration_user:replace-me@warehouse.example.com:5432/commerce_analytics"
COMMERCE_ANALYTICS_INGEST_DATABASE_URL="postgresql://commerce_ingest_user:replace-me@warehouse.example.com:5432/commerce_analytics"
COMMERCE_CONTROL_MAINTENANCE_DATABASE_URL="postgresql://commerce_maintenance_user:replace-me@postgres.example.com:5432/commerce_agent"
COMMERCE_CONTROL_BACKUP_DATABASE_URL="postgresql://commerce_backup_user:replace-me@postgres.example.com:5432/commerce_agent"
COMMERCE_ANALYTICS_BACKUP_DATABASE_URL="postgresql://commerce_backup_user:replace-me@warehouse.example.com:5432/commerce_analytics"
# Restore drills must target separate disposable databases whose names include restore/drill/test/scratch.
COMMERCE_CONTROL_RESTORE_DRILL_DATABASE_URL="postgresql://restore_owner:replace-me@postgres.example.com:5432/commerce_control_restore_drill"
COMMERCE_ANALYTICS_RESTORE_DRILL_DATABASE_URL="postgresql://restore_owner:replace-me@warehouse.example.com:5432/commerce_analytics_restore_drill"
COMMERCE_RESTORE_DRILL_CONFIRM=""

COMMERCE_PG_SSL=1
COMMERCE_PG_REJECT_UNAUTHORIZED=1
# COMMERCE_PG_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
COMMERCE_CATALOG_REFRESH_TIMEOUT_MS=300000
COMMERCE_IMPORT_MAX_ROWS=1000000
COMMERCE_CONNECTOR_RUN_RETENTION_DAYS=90
COMMERCE_CONNECTOR_STALE_RUN_MINUTES=180
# Shopify connector credentials belong in the isolated jobs environment, never
# in the Web runtime environment.
SHOPIFY_SHOP_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_replace-with-admin-api-access-token"
COMMERCE_WORKER_STALE_MS=30000
COMMERCE_RETENTION_DAYS=90
