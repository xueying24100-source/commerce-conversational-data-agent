COMMERCE_TEST_DATABASE_CONFIRM="commerce-integration"
COMMERCE_LIVE_E2E_DATABASE_URL="postgresql://commerce_app:commerce_local_password@127.0.0.1:35433/commerce_agent"
COMMERCE_LIVE_E2E_CONFIRM="commerce-live-e2e"
COMMERCE_LIVE_E2E_MODEL="deepseek-v4-flash"
