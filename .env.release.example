# Local-only Commerce release evidence configuration.
# Copy this file to .env.release.local and provide the release credentials below.

# Install mirrors may omit npm's audit API. Override only with a compatible trusted endpoint.
COMMERCE_NPM_AUDIT_REGISTRY="https://registry.npmjs.org"

COMMERCE_TEST_DATABASE_URL="postgresql://commerce_app:commerce_local_password@127.0.0.1:35433/commerce_agent"
COMMERCE_TEST_DATABASE_CONFIRM="commerce-integration"
COMMERCE_LIVE_E2E_DATABASE_URL="postgresql://commerce_app:commerce_local_password@127.0.0.1:35433/commerce_agent"
COMMERCE_LIVE_E2E_CONFIRM="commerce-live-e2e"
COMMERCE_LIVE_E2E_MODEL="deepseek-v4-flash"
COMMERCE_REAL_MODEL_EVAL_ENDPOINT=""
COMMERCE_REAL_MODEL_EVAL_TOKEN=""
COMMERCE_REAL_MODEL_EVAL_MODEL="deepseek-v4-flash"
COMMERCE_FINAL_CONTROLLER_EVAL_ENDPOINT=""
COMMERCE_FINAL_CONTROLLER_EVAL_TOKEN=""
COMMERCE_FINAL_CONTROLLER_EVAL_CONCURRENCY=4
COMMERCE_FINAL_CONTROLLER_EVAL_TIMEOUT_MS=90000

# Immutable external release evidence. Use either a local path or an HTTPS URL
# plus the expected raw-file SHA-256 (64 lowercase hexadecimal characters).
COMMERCE_PERFORMANCE_EVIDENCE_PATH=""
COMMERCE_PERFORMANCE_EVIDENCE_URL=""
COMMERCE_PERFORMANCE_EVIDENCE_SHA256=""
COMMERCE_FEISHU_SANDBOX_EVIDENCE_PATH=""
COMMERCE_FEISHU_SANDBOX_EVIDENCE_URL=""
COMMERCE_FEISHU_SANDBOX_EVIDENCE_SHA256=""
COMMERCE_USABILITY_EVIDENCE_PATH=""
COMMERCE_USABILITY_EVIDENCE_URL=""
COMMERCE_USABILITY_EVIDENCE_SHA256=""

# Inputs used when generating the performance report in the disposable fixed
# reference environment. Review-enqueue evidence is produced from scheduler
# timestamps and bound into the same report.
COMMERCE_PERF_CONFIRM="commerce-performance"
COMMERCE_PERF_ORIGIN="https://commerce-perf.example.invalid"
COMMERCE_PERF_PROXY_SECRET=""
COMMERCE_PERF_TENANT_ID="tenant_performance_fixture"
COMMERCE_PERF_USER_ID="performance_reader"
COMMERCE_PERF_EVIDENCE_PATH="/api/commerce/conversations/conv_replace/messages/msg_replace/report?format=json"
COMMERCE_PERF_REVIEW_EVIDENCE_PATH=""
COMMERCE_PERF_REQUESTS_PER_ENDPOINT=1000
COMMERCE_PERF_CONCURRENCY=10
COMMERCE_PERF_WORKER_DISABLED=1
COMMERCE_PERF_REGION=""
COMMERCE_PERF_WORKER_COUNT=0
COMMERCE_PERF_DATABASE_SPEC=""
COMMERCE_PERF_MODEL="deepseek:deepseek-v4-flash"
COMMERCE_PERF_FIXTURE_SHA256="sha256:replace-with-64-hex-characters"
COMMERCE_PERF_CACHE_STATE="warm"
DEEPSEEK_API_KEY=""
DAILY_MODEL_BUDGET_USD=25
# Replace these with the highest contracted rates across every enabled model profile.
COMMERCE_MODEL_INPUT_USD_PER_MILLION_TOKENS=1
COMMERCE_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=4
COMMERCE_DIAGNOSTIC_POLICY_ENABLED=1
COMMERCE_ANOMALY_DETECTION_ENABLED=1
COMMERCE_GLOBAL_KILL_SWITCH=0
COMMERCE_WEEKLY_DIAGNOSIS_ENABLED=0
COMMERCE_AUTOMATIC_REVIEW_ENABLED=0
COMMERCE_FEISHU_NOTIFICATIONS_ENABLED=0
COMMERCE_FEISHU_OPERATOR_ALLOWLIST=""
COMMERCE_FEISHU_APP_ID=""
COMMERCE_FEISHU_APP_SECRET=""
COMMERCE_FEISHU_BASE_URL="https://open.feishu.cn"

# Production role-capability evidence. The verifier requires seven mutually exclusive
# responsibilities: control API, control Worker, analytics readonly, analytics ingest,
# maintenance, migration, and backup. Control/analytics migration may share one
# role; control/analytics backup may share one role. These credentials are passed
# only to the role-verifier subprocess.
COMMERCE_CONTROL_API_DATABASE_URL="postgresql://commerce_control_api_user:replace-me@control-db.internal:5432/commerce_control"
COMMERCE_CONTROL_WORKER_DATABASE_URL="postgresql://commerce_control_worker_user:replace-me@control-db.internal:5432/commerce_control"
COMMERCE_ANALYTICS_DATABASE_URL="postgresql://commerce_readonly_user:replace-me@analytics-db.internal:5432/commerce_analytics"
COMMERCE_ANALYTICS_INGEST_DATABASE_URL="postgresql://commerce_ingest_user:replace-me@analytics-db.internal:5432/commerce_analytics"
COMMERCE_CONTROL_MAINTENANCE_DATABASE_URL="postgresql://commerce_maintenance_user:replace-me@control-db.internal:5432/commerce_control"
COMMERCE_CONTROL_MIGRATION_DATABASE_URL="postgresql://commerce_migration_user:replace-me@control-db.internal:5432/commerce_control"
COMMERCE_ANALYTICS_MIGRATION_DATABASE_URL="postgresql://commerce_migration_user:replace-me@analytics-db.internal:5432/commerce_analytics"
COMMERCE_CONTROL_BACKUP_DATABASE_URL="postgresql://commerce_backup_user:replace-me@control-db.internal:5432/commerce_control"
COMMERCE_ANALYTICS_BACKUP_DATABASE_URL="postgresql://commerce_backup_user:replace-me@analytics-db.internal:5432/commerce_analytics"

# Disposable restore-drill targets. Database names must contain restore, drill, scratch or test.
COMMERCE_CONTROL_RESTORE_DRILL_DATABASE_URL="postgresql://commerce_restore_user:replace-me@control-db.internal:5432/commerce_control_restore_drill"
COMMERCE_ANALYTICS_RESTORE_DRILL_DATABASE_URL="postgresql://commerce_restore_user:replace-me@analytics-db.internal:5432/commerce_analytics_restore_drill"
COMMERCE_RESTORE_DRILL_CONFIRM="commerce-restore-drill"
COMMERCE_RESTORE_DRILL_TARGET_MARKER="replace-with-at-least-32-random-characters"

# Final-image production-topology smoke. These URLs must be reachable from Docker,
# use different runtime roles, verify TLS, and point at a pre-migrated disposable
# control/analytics fixture. The tenant must contain a recent, known-answer dataset.
COMMERCE_RELEASE_SMOKE_CONFIRM="commerce-final-image-smoke"
COMMERCE_RELEASE_SMOKE_CONTROL_DATABASE_URL="postgresql://commerce_control_api_user:replace-me@control-db.internal:5432/commerce_control"
COMMERCE_RELEASE_SMOKE_WORKER_DATABASE_URL="postgresql://commerce_control_worker_user:replace-me@control-db.internal:5432/commerce_control"
COMMERCE_RELEASE_SMOKE_ANALYTICS_DATABASE_URL="postgresql://commerce_readonly_user:replace-me@analytics-db.internal:5432/commerce_analytics"
COMMERCE_RELEASE_SMOKE_TENANT_ID="tenant_release_fixture"
COMMERCE_RELEASE_SMOKE_USER_ID="release_smoke_operator"
COMMERCE_RELEASE_SMOKE_MODEL="deepseek-v4-flash"
COMMERCE_RELEASE_SMOKE_QUESTION="2026-07-01 到 2026-07-07、SKU-LIVE 的 GMV 总额是多少？"
COMMERCE_RELEASE_SMOKE_EXPECTED_METRIC="gmv"
COMMERCE_RELEASE_SMOKE_EXPECTED_VALUE="700"
COMMERCE_RELEASE_SMOKE_EXPECTED_UNIT="currency"
COMMERCE_PG_SSL=1
COMMERCE_PG_REJECT_UNAUTHORIZED=1
# COMMERCE_PG_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
