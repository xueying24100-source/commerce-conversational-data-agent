# Commerce Conversational Data Agent - production contract.

COMMERCE_RELEASE_REVISION=""
COMMERCE_PUBLIC_ORIGIN=""

# Control plane: read/write only for Commerce conversations, runs, evidence and rate limits.
COMMERCE_DATABASE_URL="postgresql://commerce_control_user:replace-me@postgres.example.com:5432/commerce_agent"

# Analytics plane: dedicated read-only role; never grant INSERT/UPDATE/DELETE/DDL.
COMMERCE_ANALYTICS_DATABASE_URL="postgresql://commerce_readonly_user:replace-me@warehouse.example.com:5432/commerce_analytics"
COMMERCE_PG_SSL=1
COMMERCE_PG_REJECT_UNAUTHORIZED=1
COMMERCE_PG_POOL_MAX=10
# COMMERCE_PG_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# The reverse proxy must remove caller-provided identity headers, authenticate the
# user, then inject x-commerce-tenant-id, x-commerce-user-id,
# x-commerce-user-name, x-commerce-scopes (including commerce:data:read) and
# x-commerce-proxy-secret.
COMMERCE_TRUSTED_PROXY_SECRET=""
COMMERCE_METRICS_TOKEN=""
COMMERCE_DEV_AUTH_BYPASS=0

# Choose one provider. Credentials remain server-side.
# MODELPORT_API_KEY="replace-with-modelport-api-key"
# COMMERCE_MODELPORT_URL="https://modelport.internal.example.com"
# COMMERCE_MODELPORT_ORGANIZATION_ID="org_commerce"
# COMMERCE_MODELPORT_PROJECT_ID="prj_commerce_agent"
# COMMERCE_MODELPORT_ENVIRONMENT_ID="env_production"
# DEEPSEEK_API_KEY=""
COMMERCE_LLM_AGENT_ENABLED=1

COMMERCE_AGENT_MAX_TURNS=8
COMMERCE_AGENT_MAX_TOOL_CALLS=12
COMMERCE_AGENT_MAX_OUTPUT_TOKENS=12000
COMMERCE_AGENT_MAX_INPUT_TOKENS=80000
COMMERCE_AGENT_MAX_PREPARED_INPUT_TOKENS=240000
COMMERCE_AGENT_TIMEOUT_MS=60000
COMMERCE_AGENT_RATE_LIMIT_PER_MINUTE=20
COMMERCE_AGENT_TENANT_RATE_LIMIT_PER_MINUTE=200
COMMERCE_AGENT_GLOBAL_CONCURRENCY=8
COMMERCE_AGENT_TENANT_CONCURRENCY=4
COMMERCE_AGENT_HISTORY_MESSAGES=24
COMMERCE_AGENT_HISTORY_CHARS=48000
COMMERCE_CATALOG_PREVIEW_LIMIT=100
COMMERCE_MAX_DATA_AGE_HOURS=72
COMMERCE_JOB_LEASE_MS=150000
COMMERCE_JOB_POLL_MS=1000
COMMERCE_JOB_RETRY_BASE_MS=2000
COMMERCE_JOB_RETRY_MAX_MS=60000
COMMERCE_JOB_MAX_ATTEMPTS=3
COMMERCE_MAX_QUEUED_JOBS_PER_USER=8
COMMERCE_WORKER_STALE_MS=30000

# Build with COMMERCE_STANDALONE_BUILD=1 for the Docker standalone server.
COMMERCE_STANDALONE_BUILD=1
COMMERCE_SECURITY_HSTS=1
